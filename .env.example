# ═══════════════════════════════════════════════════════════════
#  CORTEX — Environment Configuration
#  Copy this to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────
DB_PASSWORD=change_me_strong_password
DATABASE_URL=postgresql://cortex:${DB_PASSWORD}@db:5432/cortex

# ── Application ───────────────────────────────────────────────
APP_PORT=3000
CORTEX_ENV=production

# IMPORTANT: Generate a real secret key for production
# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-real-secret-key

# Public URL where CORTEX is accessible (for OAuth callbacks)
BASE_URL=https://your-domain.com

# ── OAuth — Google (optional) ─────────────────────────────────
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth 2.0 Client ID (Web application)
# 3. Add authorized redirect URI: ${BASE_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── OAuth — GitHub (optional) ─────────────────────────────────
# 1. Go to https://github.com/settings/developers
# 2. Create a new OAuth App
# 3. Set callback URL: ${BASE_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── LLM Provider API Keys (optional — can set via Settings UI) ──
# At least one key is needed for agents to run
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
PERPLEXITY_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
TOGETHER_API_KEY=
