# Never commit the populated .env file.
CORTEX_ENV=production
DB_PASSWORD=replace-with-a-random-database-password
SECRET_KEY=replace-with-at-least-32-random-characters
CORTEX_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
BASE_URL=https://cortex.example.com
CORS_ORIGINS=https://cortex.example.com
TRUSTED_HOSTS=cortex.example.com
CORTEX_AUTHZ_FAIL_CLOSED=true
ALLOW_SIGNUP=false
CORTEX_BOOTSTRAP_TOKEN=replace-with-at-least-32-random-characters
SEED_SAMPLE_AGENTS=false
SECURE_COOKIES=true
FORWARDED_ALLOW_IPS=127.0.0.1

# Optional providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
